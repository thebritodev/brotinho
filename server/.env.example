# Copie para .env. Com o padrão (local) não é preciso preencher nada.

# local | groq | openai | deepgram
#
# local  → Whisper rodando nesta máquina. Sem chave, sem conta, sem custo, e o
#          áudio não sai daqui. Na primeira execução baixa o modelo (~150 MB).
# groq   → nuvem, camada gratuita sem cartão: https://console.groq.com/keys
# openai → nuvem, ~US$ 0,006 por minuto: https://platform.openai.com/api-keys
# deepgram → nuvem, crédito inicial gratuito: https://console.deepgram.com
TRANSCRIPTION_PROVIDER=local

# Modelo do Whisper local. `small` é o padrão: num teste com frases de diário em
# português, errou 0% contra 12,5% do `base`, custando 0,8s a mais por frase.
# `onnx-community/whisper-large-v3-turbo` é mais robusto com ruído e sotaque,
# mas baixa ~800 MB e roda bem mais devagar em CPU.
LOCAL_WHISPER_MODEL=onnx-community/whisper-small

GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

OPENAI_API_KEY=
OPENAI_MODEL=whisper-1

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

PORT=8787
