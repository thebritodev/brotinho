# Copie para .env e ajuste o IP da sua máquina na rede.
# Sem esta variável o app grava o áudio normalmente, mas insere um texto de
# demonstração no lugar da transcrição (e avisa isso na tela).
#
# O backend fica em server/ — veja server/README.md.
EXPO_PUBLIC_TRANSCRIPTION_URL=http://192.168.0.91:8787/transcrever

# Chaves públicas do RevenueCat, para a assinatura.
# Sem elas o app não cobra e não bloqueia ninguém — é assim que se testa no
# Expo Go. Veja docs/ativar-assinaturas.md.
EXPO_PUBLIC_REVENUECAT_IOS=
EXPO_PUBLIC_REVENUECAT_ANDROID=
